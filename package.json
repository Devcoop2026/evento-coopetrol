{
  "name": "simulador-evento-coopetrol",
  "version": "1.0.0",
  "private": true,
  "description": "Simulador, preinscripción y soporte de pago del evento de fin de año para asociados Coopetrol",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "tarifas": "py scripts/importar_tarifas.py",
    "admin": "node scripts/crear_admin.js",
    "respaldo": "node scripts/respaldo.js",
    "base": "node scripts/cargar_base.js",
    "dev": "node -e \"process.env.DATOS_PRUEBA='1';process.env.EVENTO_DB='data/evento-dev.db';require('./server.js').iniciar()\"",
    "limpiar": "node --disable-warning=ExperimentalWarning scripts/limpiar.js",
    "restaurar": "node scripts/restaurar.js"
  }
}
