storage/framework/views/*
storage/framework/testing/*
storage/app/private/*
storage/app/public/*
storage/app/soportes
storage/app/livewire-tmp
!storage/**/.gitignore
bootstrap/cache/*.php

# Datos: bases SQLite de la versión anterior, comprobantes y datos ficticios
data/*.db
data/*.db-*
data/soportes
data/asociados.json
data/coopetrolitos.json
