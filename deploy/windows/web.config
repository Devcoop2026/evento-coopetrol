<?xml version="1.0" encoding="utf-8"?>
<!--
  Proxy inverso de IIS al contenedor del Evento Coopetrol (requiere URL Rewrite 2.1 y Application Request Routing 3).
  configurar-iis.ps1 copia este archivo a la carpeta del sitio o de la aplicación y reemplaza PUERTO_EVENTO.
  Sirve como sitio propio (https://eventos.coopetrol.coop/) o como aplicación dentro de otro sitio
  (https://sistemas.coopetrol.coop/portal-eventos/): las reglas se evalúan relativas a la aplicación y el prefijo se
  quita al reenviar; el contenedor recibe RUTA_BASE para la ruta de la cookie de sesión.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- No se heredan las reglas del sitio padre. -->
        <clear />
        <!-- Todo por HTTPS. -->
        <rule name="EventoCoopetrol-HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" />
        </rule>
        <!-- /portal-eventos -> /portal-eventos/ (las rutas de la página son relativas a la carpeta). -->
        <rule name="EventoCoopetrol-BarraFinal" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^([^?]*[^/])(\?.*)?$" />
          </conditions>
          <action type="Redirect" url="{C:1}/{C:2}" redirectType="Permanent" />
        </rule>
        <!-- Proxy al contenedor. X-Real-IP lleva la IP real del cliente (límites por IP, registro de seguridad y
             PANEL_REDES); se sobrescribe siempre, así un cliente no puede falsificarla. -->
        <rule name="EventoCoopetrol" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:PUERTO_EVENTO/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <!-- 30 MB: cargas de bases (Excel/CSV en base64) y soportes de pago. removeServerHeader oculta "Microsoft-IIS". -->
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- remove antes de add: si el sitio padre ya define HSTS, IIS no admite la entrada duplicada. -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
