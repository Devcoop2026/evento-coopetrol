[Unit]
Description=Evento Fin de Año Coopetrol (simulador, preinscripción y soportes de pago)
After=network.target

[Service]
Type=simple
User=evento
Group=evento
WorkingDirectory=/opt/evento-coopetrol
EnvironmentFile=/etc/evento-coopetrol/evento.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=5

# Endurecimiento: el servicio solo puede escribir en sus carpetas de datos.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadWritePaths=/var/lib/evento-coopetrol /opt/evento-coopetrol/data

[Install]
WantedBy=multi-user.target
