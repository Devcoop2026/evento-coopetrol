APP_NAME="Evento Coopetrol"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Seeder opcional del usuario administrador (no subir una clave real al repositorio).
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador
ADMIN_CLAVE=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# Registro de seguridad (una línea JSON por evento). En Render use php://stderr para verlo en los logs del servicio.
LOG_SEGURIDAD=storage/logs/seguridad.log

# ---- MySQL (InfinityFree u otro hosting compartido) ----
# En InfinityFree copie estos valores desde el panel de MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_xxxxx_evento
DB_USERNAME=if0_xxxxx
DB_PASSWORD=

# Sesiones del panel: 8 horas, solo HTTPS en producción, SameSite estricto.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Detrás de un proxy (Render): direcciones de confianza para tomar la IP del cliente de X-Forwarded-For. "*" = el proxy inmediato.
TRUSTED_PROXIES=

# ---- Evento ----
# Clave HMAC de las fechas de expedición (mínimo 32 caracteres; obligatoria en producción).
EVENTO_SECRETO=
# Comprobantes de pago: base_datos (por defecto) o el nombre de un disco (soportes, s3).
SOPORTES_ALMACEN=base_datos
# Panel solo desde estas redes (CIDR separados por coma). Vacío = sin restricción.
PANEL_REDES=
MAX_ACOMPANANTES=5
MESES_VIGENCIA_DATOS=12
# En hosting compartido use una ruta privada, fuera del directorio publico, para comprobantes.
SOPORTES_ALMACEN=soportes
# SOPORTES_DIR=/ruta/privada/soportes
# Respaldos: clave de 64 hexadecimales para cifrarlos (AES-256-GCM).
RESPALDO_CLAVE=
RESPALDO_DIR=
RETENCION_DIAS=30
# Ruta de pg_dump si no está en el PATH (versión igual o superior a la del servidor).
